PORT=4000
CORS_ORIGINS=https://huddle-v0-01.vercel.app
# ---- Paid entry (OFF unless every value below is valid) ----
PAID_ENTRY_ENABLED=false
SOLANA_CLUSTER=devnet            # devnet | testnet | mainnet-beta
MAINNET_ACK=false                # mainnet is refused unless true (only after legal review)
SOLANA_RPC_URL=                  # optional; defaults to the public RPC for the cluster
TREASURY_ADDRESS=                # PUBLIC address that receives entry fees (never a private key)
USDC_MINT=                       # optional; defaults to Circle USDC for the cluster
SOL_USD_RATE=                    # manual SOL price for quoting SOL entries; empty = USDC only
PAID_CURRENCIES=USDC,SOL
RAKE_BPS=1000                    # 1000 = 10%
ADMIN_KEY=                       # 24+ random chars; protects /admin/payouts
DYNAMIC_ENVIRONMENT_ID=          # Dynamic.xyz environment id (wallet login JWT verification)
FRIENDS_ALLOWLIST=               # comma-separated wallet addresses allowed to enter
BLOCKED_REGIONS=AZ,AR,CT,DE,LA,MT,SC,SD,TN
REGION_HEADER=                   # trusted geo header set by your proxy (e.g. x-region)
MAX_ENTRIES_PER_DAY=10
MAX_DAILY_USD=50
MAX_TIER=low                     # highest buy-in level allowed: micro|low|mid|high|whale
FILL_TIMEOUT_MIN=30              # refund paid entries if the table hasn't filled
LEDGER_FILE=                     # optional JSON persistence path (use Postgres for production)
